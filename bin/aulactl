#!/usr/bin/env python3
"""aulactl — подсветка AULA F75 (Greywood V3) через /dev/hidraw.

Только стандартная библиотека. Пакеты не выдуманы: каждый взят из
разобранных сообществом проектов и сверен между ними (см. `aulactl selftest`):

  провод 258a:010c, интерфейс 1, feature report 6, 520 байт
    0x84 чтение конфига (128)      Vantesh/aulaf75ctl, lukatasev, br0k3nb
    0x04 запись конфига (128)      те же трое, read-modify-write
    0x86 чтение матрицы (384)      Vantesh
    0x06 запись матрицы (384)      Vantesh (Studio: matrix -> config)
    0x82 модель                    Vantesh
    0x08 живой кадр (378)          OpenRGB, kveld9, lukatasev, Vantesh
  донгл 3554:fa09, report 0x13, 20 байт, чанки по 14 + сумма
    0x44/0x04 конфиг, 0x42/0x02 цвета, 0x49/0x09 палитры,
    0x07 связь, 0x4A заряд, 0x88 живой кадр          lukatasev

Report 5 не отправляется никогда: на этом семействе МК это почтовый ящик
загрузчика прошивки. Прошивка и любые иные области памяти не трогаются.

Запись конфига и матрицы сохраняется в клавиатуре (как и её собственные
Fn-сочетания). Перед первой записью снимается резервная копия в
~/.local/state/aulactl/. Живой кадр ничего не сохраняет.
"""

import argparse
