    10: ("snake",         True,  True,  True),
    11: ("neon",          True,  True,  True),
    12: ("reactive",      True,  True,  True),
    13: ("sine_wave",     True,  True,  True),
    14: ("scanner",       True,  True,  False),
    15: ("windmill",      True,  False, True),
    16: ("waterfall",     True,  False, True),
    17: ("blossom",       True,  False, True),
    18: ("storm",         True,  True,  False),
    21: ("custom",        False, False, True),
}
ALIASES = {
    "fixed": 1, "fixed_on": 1, "solid": 1, "respire": 2, "breathing": 2,
    "flash": 4, "rain": 5, "wheel": 6, "ripple": 7, "stars_twinkle": 8,
