    "self_defined": 21, "per_key": 21, "perkey": 21,
}
PALETTE = ["red", "green", "blue", "yellow", "magenta", "cyan", "white", "random"]
INDICATOR = ["off", "blink", "slow_blink", "on"]
SLEEP = [(60, 2), (90, 3), (120, 4), (180, 6), (240, 8),
         (300, 10), (600, 20), (900, 30), (1200, 40)]

def slot_of(eid):
    if 1 <= eid <= 18:
        return eid - 1
    if eid == 21:
        return 18
    if eid == 0:
        return 19
    return None

