#!/usr/bin/env bash
# Pull the latest revision of this configuration and apply it in place.
set -euo pipefail

for dir in "$HOME/hyprdots" "${XDG_DATA_HOME:-$HOME/.local/share}/hyprdots"; do
    if [[ -d "$dir/.git" ]]; then
        exec bash "$dir/install.sh" --update "$@"
    fi
done

echo "no hyprdots checkout found; run the installer once first" >&2
exit 1
