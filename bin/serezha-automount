#!/usr/bin/env bash

set -u

have() { command -v "$1" >/dev/null 2>&1; }
have udisksctl || { printf 'serezha-automount: нет udisksctl\n' >&2; exit 1; }

notify() {
    have notify-send || return 0
    notify-send -a "носитель" -u low "$1" "${2-}" >/dev/null 2>&1
}

suitable() {
    local dev="$1" props
    props=$(lsblk -no HOTPLUG,FSTYPE,MOUNTPOINT,TYPE "$dev" 2>/dev/null | head -1)
    [[ -n "$props" ]] || return 1

    local hotplug fstype mountpoint type
    read -r hotplug fstype mountpoint type <<<"$props"

    [[ "$hotplug" == "1" ]]      || return 1
    [[ "$type" == "part" || "$type" == "disk" ]] || return 1
    [[ -n "$fstype" ]]           || return 1
    [[ "$fstype" == "swap" ]]    && return 1
    [[ -z "$mountpoint" ]]       || return 1
    return 0
}

mount_dev() {
    local dev="$1" out
    suitable "$dev" || return 0
    out=$(udisksctl mount --no-user-interaction -b "$dev" 2>&1)
    case "$out" in
        *"Mounted "*) notify "смонтировано" "${out##*at }" ;;
        *"already mounted"*) : ;;
        *) notify "не смонтировано" "${dev##*/}" ;;
    esac
}

scan_all() {
    local dev
    while read -r dev; do
        [[ -b "$dev" ]] && mount_dev "$dev"
    done < <(lsblk -pnro NAME 2>/dev/null)
}

if [[ "${1-}" == "--once" ]]; then
    scan_all
    exit 0
fi

scan_all

udevadm monitor --udev --subsystem-match=block --property 2>/dev/null |
while read -r line; do
    case "$line" in
        DEVNAME=*) devname="${line#DEVNAME=}" ;;
        ACTION=add) action=add ;;
        ACTION=*)   action="${line#ACTION=}" ;;
        "")
            if [[ "${action-}" == "add" && -n "${devname-}" ]]; then
                mount_dev "$devname"
            fi
            unset action devname
            ;;
    esac
done
