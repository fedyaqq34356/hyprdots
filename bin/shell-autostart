#!/usr/bin/env bash

start_watchdog() {
    pgrep -f "$HOME/.local/bin/shell-watchdog" >/dev/null && return 0
    setsid -f "$HOME/.local/bin/shell-watchdog" >/dev/null 2>&1
}

if ! command -v quickshell >/dev/null; then
    command -v notify-send >/dev/null &&
        notify-send -u critical "Shell" "quickshell не установлен: sudo pacman -S quickshell"
    exit 1
fi

pkill -x dunst 2>/dev/null
QS_NO_RELOAD_POPUP=1 setsid -f quickshell -n -c f >/dev/null 2>&1

start_watchdog
