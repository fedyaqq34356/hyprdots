#!/usr/bin/env bash

exec 9>"$HOME/.cache/shell-watchdog.lock"
flock -n 9 || exit 0

CHECK_INTERVAL=5
FAIL_LIMIT=3
FAIL_WINDOW=120

fails=0
last_fail=0
misses=0
gave_up=0

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "shell" "$@" 2>/dev/null
}

start_qs() {
    QS_NO_RELOAD_POPUP=1 setsid -f quickshell -n -c f >/dev/null 2>&1
}

while true; do
    sleep "$CHECK_INTERVAL"

    if pgrep -x 'quickshell|qs' >/dev/null; then
        fails=0
        misses=0
        gave_up=0
        continue
    fi

    (( gave_up )) && continue

    misses=$((misses + 1))
    (( misses < 2 )) && continue
    misses=0

    now=$SECONDS
    (( now - last_fail > FAIL_WINDOW )) && fails=0
    last_fail=$now
    fails=$((fails + 1))

    if (( fails >= FAIL_LIMIT )); then
        gave_up=1
        notify -u critical "Shell" \
            "quickshell упал $fails раза подряд, перезапуск остановлен. Руками: shell-switch qs"
        fails=0
        continue
    fi

    notify "Shell" "quickshell упал, перезапускаю (попытка $fails)"
    start_qs
done
