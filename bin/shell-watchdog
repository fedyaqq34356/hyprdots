#!/usr/bin/env bash
# Keep exactly one bar running for the session.
#
# Two jobs:
#   - restart quickshell if it dies, and fall back to waybar if it keeps dying;
#   - make sure the two never run at the same time. A fallback that leaves the
#     old shell running gives you two stacked bars, which is what happened
#     before this check existed.

exec 9>"$HOME/.cache/shell-watchdog.lock"
flock -n 9 || exit 0

CHOICE_FILE="$HOME/.config/hypr/shell-choice"
CHECK_INTERVAL=5
FAIL_LIMIT=3
FAIL_WINDOW=120

fails=0
last_fail=0
# Set when quickshell has failed too many times in a row. Deliberately NOT
# written to the choice file: persisting the fallback meant one bad afternoon
# of restarts silently changed which shell starts at every future login, and
# the user found waybar after a reboot with no idea why.
fell_back=0
# A restart the user performed by hand looks identical to a crash. Requiring
# two consecutive misses means a quick manual restart is not counted.
misses=0

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "shell" "$@" 2>/dev/null
}

start_qs() {
    QS_NO_RELOAD_POPUP=1 setsid -f quickshell -n -c f >/dev/null 2>&1
}

stop_waybar() {
    pkill -x waybar 2>/dev/null
    pkill -x dunst  2>/dev/null
}

start_waybar() {
    pgrep -x waybar >/dev/null || setsid -f waybar >/dev/null 2>&1
    pgrep -x dunst  >/dev/null || setsid -f dunst  >/dev/null 2>&1
}

while true; do
    sleep "$CHECK_INTERVAL"

    choice=$(cat "$CHOICE_FILE" 2>/dev/null || echo waybar)

    # The user editing the choice file clears an earlier fallback.
    [[ "$choice" == "qs" ]] || fell_back=0
    (( fell_back )) && choice=waybar

    if [[ "$choice" != "qs" ]]; then
        # waybar is the chosen shell: quickshell must not also be up.
        pgrep -x 'quickshell|qs' >/dev/null && pkill -x 'quickshell|qs' 2>/dev/null
        start_waybar
        fails=0
        misses=0
        continue
    fi

    if pgrep -x 'quickshell|qs' >/dev/null; then
        # quickshell owns the bar, so nothing else may draw one.
        pgrep -x waybar >/dev/null && stop_waybar
        fails=0
        misses=0
        continue
    fi

    misses=$((misses + 1))
    (( misses < 2 )) && continue
    misses=0

    now=$SECONDS
    (( now - last_fail > FAIL_WINDOW )) && fails=0
    last_fail=$now
    fails=$((fails + 1))

    if (( fails >= FAIL_LIMIT )); then
        fell_back=1
        pkill -x 'quickshell|qs' 2>/dev/null
        start_waybar
        sleep 2
        notify -u critical "Shell" \
            "quickshell упал $fails раза подряд, временно waybar. Вернуть: echo qs > ~/.config/hypr/shell-choice"
        fails=0
        continue
    fi

    notify "Shell" "quickshell упал, перезапускаю (попытка $fails)"
    start_qs
done
