#!/usr/bin/env bash

start_qs() {
    if ! command -v quickshell >/dev/null; then
        echo "quickshell is not installed. Run: sudo pacman -S quickshell" >&2
        exit 1
    fi
    pkill -x dunst 2>/dev/null
    pkill -x 'quickshell|qs' 2>/dev/null
    sleep 0.6
    QS_NO_RELOAD_POPUP=1 setsid -f quickshell -n -c f >/dev/null 2>&1
    sleep 2
    if pgrep -x 'quickshell|qs' >/dev/null; then
        echo "-> quickshell"
    else
        echo "quickshell failed to start" >&2
        exit 1
    fi
}

case "${1:-status}" in
    qs|restart) start_qs ;;
    stop)  pkill -x 'quickshell|qs' 2>/dev/null; echo "-> stopped" ;;
    status)
        if pgrep -x 'quickshell|qs' >/dev/null; then
            echo "quickshell running"
        else
            echo "quickshell not running"
        fi
        ;;
    *) echo "usage: shell-switch [qs|restart|stop|status]" >&2; exit 1 ;;
esac
