{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,
    "margin": "0",
    "reload_style_on_change": false,

    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right":  ["wireplumber", "network", "battery", "clock"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false,
        "sort-by-number": true,
        "disable-scroll": true
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 90,
        "separate-outputs": true,
        "rewrite": {
            "": ""
        }
    },

    "wireplumber": {
        "format": "vol {volume}",
        "format-muted": "vol --",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "@HOME@/.local/bin/serezha-menu audio",
        "max-volume": 100,
        "tooltip": false
    },

    "network": {
        "interval": 60,
        "format-wifi": "{essid}",
        "format-ethernet": "eth",
        "format-linked": "no ip",
        "format-disconnected": "net --",
        "max-length": 18,
        "on-click": "kitty --class serezha-tui -e nmtui",
        "tooltip": false
    },

    "battery": {
        "interval": 60,
        "states": { "warning": 20, "critical": 10 },
        "format": "bat {capacity}",
        "format-charging": "bat {capacity}+",
        "format-plugged": "bat {capacity}=",
        "tooltip": false
    },

    "clock": {
        "interval": 60,
        "format": "{:%a %d.%m  %H:%M}",
        "tooltip": false
    }
}
