[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 80
    origin = top-right
    offset = 12x48
    notification_limit = 4
    progress_bar = true
    progress_bar_height = 3
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 260
    highlight = "{{colors.primary.default.hex}}"
    transparency = 8
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 1
    frame_color = "{{colors.outline_variant.default.hex}}"
    separator_color = "{{colors.outline_variant.default.hex}}"
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    icon_position = left
    min_icon_size = 28
    max_icon_size = 36
    icon_theme = Papirus-Dark
    corner_radius = 10
    mouse_left_click = close_current
    mouse_right_click = close_all
    sort = yes

[urgency_low]
    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface_variant.default.hex}}"
    frame_color = "{{colors.outline_variant.default.hex}}"
    timeout = 3

[urgency_normal]
    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.primary.default.hex}}"
    timeout = 4

[urgency_critical]
    background = "{{colors.surface.default.hex}}"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
