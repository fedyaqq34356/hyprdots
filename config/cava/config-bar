# Отдельный экземпляр cava для визуализатора в баре.
# Интерактивный конфиг (~/.config/cava/config) не трогаем: там свои
# цвета и режим вывода, а тут нужен сырой поток чисел в stdout.

[general]
framerate = 60
autosens = 1
bars = 12

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100

[smoothing]
noise_reduction = 45
