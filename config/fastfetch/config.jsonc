{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "artix",
        "padding": { "top": 1, "right": 3 },
        "color": { "1": "4", "2": "8" }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 2 },
        "color": { "keys": "8", "title": "4" }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": { "user": "4", "at": "8", "host": "8" }
        },
        "break",
        { "type": "os",      "key": "󰣇", "keyColor": "8" },
        { "type": "kernel",  "key": " ", "keyColor": "8" },
        { "type": "shell",   "key": " ", "keyColor": "8" },
        { "type": "uptime",  "key": "󰅐", "keyColor": "8" },
        "break",
        { "type": "cpu",     "key": " ", "keyColor": "8",
          "showPeCoreCount": false },
        { "type": "gpu",     "key": "󰍛", "keyColor": "8" },
        { "type": "memory",  "key": " ", "keyColor": "8" },
        { "type": "disk",    "key": "󰋊", "keyColor": "8",
          "folders": "/" },
        "break",
        { "type": "colors",  "symbol": "circle", "paddingLeft": 2 }
    ]
}
