{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "artix",
        "padding": { "top": 1, "right": 3 },
        "color": {
            "1": "38;5;141",
            "2": "38;5;105"
        }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;5;141", "title": "38;5;141" }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": { "user": "38;5;183", "at": "38;5;61", "host": "38;5;141" }
        },
        "separator",
        { "type": "os",      "key": "󰣇  os",     "keyColor": "38;5;105" },
        { "type": "kernel",  "key": "   kern",   "keyColor": "38;5;105" },
        { "type": "shell",   "key": "   shell",  "keyColor": "38;5;105" },
        { "type": "uptime",  "key": "󰅐  up",     "keyColor": "38;5;105" },
        "separator",
        { "type": "cpu",     "key": "   cpu",   "keyColor": "38;5;141",
          "showPeCoreCount": false },
        { "type": "gpu",     "key": "󰍛  gpu",    "keyColor": "38;5;141" },
        { "type": "memory",  "key": "   ram",   "keyColor": "38;5;141" },
        { "type": "disk",    "key": "󰋊  disk",   "keyColor": "38;5;141",
          "folders": "/" },
        "separator",
        { "type": "colors",  "symbol": "circle", "paddingLeft": 2 }
    ]
}
