# Canon CAPT: демон ccpd привязывается к /dev/usb/lp0 в момент старта и после
# переподключения принтера продолжает держать мёртвый узел. Симптом обманчив:
# CUPS показывает «idle», задания уходят в очередь и исчезают, бумага не
# двигается. Лечится перезапуском демона на каждое появление устройства.
#
# Совпадение по классу usblp, а не по vendor/product: так правило переживёт
# смену принтера на любой другой CAPT-аппарат.
#
# systemd-run здесь нет, поэтому запуск отвязывается через setsid: udev убивает
# потомков события, а перезапуск ccpd занимает секунды и в это окно не влезает.
ACTION=="add", SUBSYSTEM=="usbmisc", KERNEL=="lp[0-9]*", \
    RUN+="/usr/bin/setsid -f /usr/local/bin/print-repair hotplug"

# Права на узел. По умолчанию root:lp 0660 — ccpd работает от root и этого
# хватает, но группа lp делает узел доступным и обычным backend'ам CUPS.
KERNEL=="lp[0-9]*", SUBSYSTEM=="usbmisc", GROUP="lp", MODE="0660"
