dbus-user.talk org.freedesktop.portal.*
dbus-user.talk org.freedesktop.FileManager1

noblacklist ${DOCUMENTS}
noblacklist ${MUSIC}
noblacklist ${PICTURES}
noblacklist ${VIDEOS}

whitelist ${DESKTOP}
whitelist ${DOCUMENTS}
whitelist ${PICTURES}
whitelist ${VIDEOS}
whitelist ${MUSIC}
whitelist ${HOME}/Files

private-bin bwrap,xdg-dbus-proxy
ignore restrict-namespaces
