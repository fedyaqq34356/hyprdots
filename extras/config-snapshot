#!/usr/bin/env bash
set -euo pipefail

STORE=/var/backups/config-snapshots
KEEP=15

usage() {
    sed -n '3,12p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

take() {
    local id ts
    ts=$(date +%Y-%m-%d_%H-%M-%S)
    id="$STORE/$ts"
    mkdir -p "$id"

    tar --zstd -cf "$id/etc.tar.zst" \
        --exclude=/etc/ssl/private \
        --exclude=/etc/shadow \
        --exclude=/etc/gshadow \
        -C / etc 2>/dev/null || true

    pacman -Qqe > "$id/pkglist-explicit.txt" 2>/dev/null || true
    pacman -Qq  > "$id/pkglist-all.txt"      2>/dev/null || true
    uname -r    > "$id/kernel.txt"

    local count
    count=$(find "$STORE" -mindepth 1 -maxdepth 1 -type d | wc -l)
    if (( count > KEEP )); then
        find "$STORE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
            | sort | head -n "$(( count - KEEP ))" \
            | while read -r old; do rm -rf "${STORE:?}/$old"; done
    fi

    echo "snapshot: $id"
}

latest() {
    find "$STORE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | tail -1
}

list() {
    [[ -d $STORE ]] || { echo "нет снимков"; return 0; }
    local d
    for d in "$STORE"/*/; do
        [[ -d $d ]] || continue
        printf '%s  %s  ядро %s  пакетов %s\n' \
            "$(basename "$d")" \
            "$(du -sh "$d" | cut -f1)" \
            "$(cat "$d/kernel.txt" 2>/dev/null || echo '?')" \
            "$(wc -l < "$d/pkglist-all.txt" 2>/dev/null || echo '?')"
    done
}

diff_snapshot() {
    local id="${1:-$(latest)}"
    [[ -n $id && -d "$STORE/$id" ]] || { echo "нет такого снимка: $id" >&2; exit 1; }

    local tmp
    tmp=$(mktemp -d)
    trap 'rm -rf "${tmp:-}"' EXIT
    tar --zstd -xf "$STORE/$id/etc.tar.zst" -C "$tmp"

    echo "изменения в /etc с $id:"
    diff -rq "$tmp/etc" /etc 2>/dev/null \
        | sed "s#$tmp/etc#снимок#g" \
        | sed 's/^Files /изменён: /; s/ and .* differ$//' \
        | sed 's/^Only in \/etc/появился в \/etc/' \
        | sed 's/^Only in снимок/удалён из/' || true
}

restore() {
    local id="${1:-}"
    [[ -n $id && -d "$STORE/$id" ]] || { echo "укажи id снимка (config-snapshot list)" >&2; exit 1; }

    echo "Это перезапишет /etc содержимым снимка $id."
    read -r -p "Впиши YES для подтверждения: " answer
    [[ $answer == YES ]] || { echo "отменено"; exit 1; }

    take >/dev/null
    tar --zstd -xf "$STORE/$id/etc.tar.zst" -C /
    echo "/etc восстановлен из $id"
    echo "пакеты не трогались; сравнить: diff <(pacman -Qq) $STORE/$id/pkglist-all.txt"
}

case "${1:-take}" in
    take)    take ;;
    list)    list ;;
    diff)    diff_snapshot "${2:-}" ;;
    restore) restore "${2:-}" ;;
    -h|--help) usage ;;
    *)       usage 1 ;;
esac
